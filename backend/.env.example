# Copy this file to ".env" and fill in real values.
# The backend reads these on startup (via python-dotenv).

# ---- Server ----
PORT=5000
# Comma-separated list of allowed frontend origins, or "*" for any (dev only).
# Example: https://solarboatuprm.org,https://www.solarboatuprm.org
ALLOWED_ORIGINS=*

# Token required to read /api/admin/submissions. Pick a long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Where the SQLite file is stored (optional; defaults to backend/solarboat.db)
# SOLARBOAT_DB=/absolute/path/to/solarboat.db

# ---- Email notifications (optional) ----
# If these are blank, submissions are still saved — just no email is sent.
# For Gmail, create an "App Password" (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
# Inbox that receives the alerts:
NOTIFY_TO=solarboat@uprm.edu
# From address shown on the emails (defaults to SMTP_USER):
NOTIFY_FROM=your-address@gmail.com
